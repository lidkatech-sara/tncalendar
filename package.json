{
  "name": "tncalendar",
  "description": "2027 Tamil Calendar, Daily Panchangam, Muhurtham & Festival portal (Astro static site on Cloudflare)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "data": "node scripts/generate-calendar-data.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "sheets": "node scripts/generate-daily-sheets.mjs",
    "social": "node scripts/generate-social-images.mjs",
    "assets": "node scripts/fetch-fonts.mjs && node scripts/generate-daily-sheets.mjs --force && node scripts/generate-social-images.mjs",
    "prebuild": "node scripts/check-assets.mjs",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.6.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "5.16.9",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
